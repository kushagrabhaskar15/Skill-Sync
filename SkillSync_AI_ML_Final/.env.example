DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=skillsync
DB_USER=skillsync_ai
DB_PASSWORD=REPLACE_WITH_AI_DB_PASSWORD

SPRING_BOOT_BASE_URL=http://localhost:8080
SPRING_BOOT_RECOMMENDATION_INGEST_PATH=/api/v1/internal/recommendations
SPRING_BOOT_API_KEY=REPLACE_WITH_BACKEND_INTERNAL_API_KEY

MAX_RECOMMENDATIONS=10
MIN_MATCH_SCORE=0.10
WEIGHT_SKILLS=0.70
WEIGHT_INTERESTS=0.30
SOURCE_VERSION=skillsync-ai-1.0.0
HTTP_TIMEOUT_SECONDS=15
# Optional ESCO Web Services settings. Enrichment does not affect peer match scores.
ESCO_API_BASE_URL=https://ec.europa.eu/esco/api
ESCO_LANGUAGE=en
ESCO_SELECTED_VERSION=
ESCO_TIMEOUT_SECONDS=3
ESCO_MAX_SKILLS_PER_GENERATION=3
