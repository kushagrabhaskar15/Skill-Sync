DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=skillsync
DB_USER=skillsync_ai
DB_PASSWORD=REPLACE_WITH_AI_DB_PASSWORD

SPRING_BOOT_BASE_URL=http://localhost:8080
SPRING_BOOT_RECOMMENDATION_INGEST_PATH=/api/recommendations/ai-ingest
SPRING_BOOT_FEEDBACK_PATH=/api/recommendations/ai-feedback
SPRING_BOOT_API_TOKEN=

MAX_RECOMMENDATIONS=10
MIN_MATCH_SCORE=0.10
WEIGHT_SKILLS=0.50
WEIGHT_INTERESTS=0.20
WEIGHT_GOALS=0.20
WEIGHT_AVAILABILITY=0.10
SOURCE_VERSION=skillsync-ai-1.0.0
HTTP_TIMEOUT_SECONDS=15
